{
  "name": "small-talk",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "postinstall": "prisma generate",
    "audio:manifest": "node scripts/build-manifest.mjs",
    "audio:generate": "node scripts/build-manifest.mjs && node scripts/generate-audio.mjs",
    "audio:validate": "node scripts/build-manifest.mjs && node scripts/validate-audio.mjs",
    "audio:review": "node scripts/build-manifest.mjs && node scripts/build-review-page.mjs",
    "audio:review-server": "node scripts/build-manifest.mjs && node scripts/review-server.mjs",
    "audio:review-report": "node scripts/review-report.mjs",
    "audio:calibrate": "node scripts/calibrate-pronunciation.mjs",
    "verify": "tsc --noEmit && npm run audio:validate"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.2",
    "@prisma/client": "^6.19.3",
    "next": "^14.2.35",
    "next-auth": "^5.0.0-beta.31",
    "react": "^18",
    "react-dom": "^18",
    "stripe": "^22.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.0.1",
    "postcss": "^8",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.3.0",
    "typescript": "^5"
  }
}
