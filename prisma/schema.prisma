// Small Talk — Phase 0 schema (Auth.js + parent User)
// Later phases add: ChildProfile, Progress, Step1Progress, Subscription, Invoice, AuditLog

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum Role {
  PARENT
  ADMIN
}

model User {
  id               String    @id @default(cuid())
  name             String?
  email            String    @unique
  emailVerified    DateTime?
  image            String?
  role             Role      @default(PARENT)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  accounts     Account[]
  sessions     Session[]
  children     ChildProfile[]
  subscription Subscription?
  classroom    Classroom?

  familyWeeklyGoal Int? // shared weekly star goal for the family (₪49+ perk); null = default
}

// ── Phase 2: billing — Grow (via Make) ───────────────────────────────────────
// Grow runs the monthly standing order (הוראת קבע). Our site only records what
// Grow reports: access lasts until currentPeriodEnd (+ a short grace), and every
// successful monthly charge pushes it forward. Cancelling / changing the amount
// is done by the owner on the Grow website — the site creates a BillingTask.

model Subscription {
  id                String    @id @default(cuid())
  userId            String    @unique
  plan              String    // parent | teacher
  tierChosen        Int       @default(0) // family tier the parent picked (0/1/2); billed tier = max(chosen, needed for #children)
  status            String    // active | past_due | canceled
  seats             Int       @default(1)   // parent: children billed · teacher: 1
  discountedSeats   Int       @default(0)   // children billed at the class (teacher code) discount
  monthlyAmount     Int                     // agorot — what Grow charges every month now
  currentPeriodEnd  DateTime                // access is paid until this moment
  cancelAtPeriodEnd Boolean   @default(false)
  canceledAt        DateTime?
  failedAttempts    Int       @default(0)
  payerName         String?
  payerPhone        String?   // needed to find the standing order in Grow
  payerEmail        String?
  cardSuffix        String?   // last 4 digits, for display
  growDirectDebitId String?   @unique // Grow standing-order id (learned from the first recurring webhook)
  // The first payment's ids — Grow's updateDirectDebit (change amount / cancel) identifies the standing order by these.
  growTransactionId    String?
  growTransactionToken String?
  growAsmachta         String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
}

/// A payment link we asked Make/Grow to create. The id travels through Grow
/// (custom field + catalog number) so the payment notice finds its way back.
model BillingCheckout {
  id              String    @id @default(cuid())
  userId          String
  plan            String    // parent | teacher
  tierChosen      Int       @default(0)
  seats           Int
  discountedSeats Int       @default(0)
  firstAmount     Int       // agorot — first month (discounted)
  monthlyAmount   Int       // agorot — from the second month
  phone           String
  status          String    @default("pending") // pending | paid
  paidAt          DateTime?
  createdAt       DateTime  @default(now())

  @@index([userId])
}

/// Every payment notice we received (raw payload kept for support). Idempotent on providerTxnId.
model BillingEvent {
  id             String   @id @default(cuid())
  userId         String?
  subscriptionId String?
  kind           String   // first_payment | recurring | recurring_failed | unmatched
  amount         Int?     // agorot
  providerTxnId  String?  @unique
  raw            Json
  createdAt      DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

/// Something the owner must do by hand on the Grow website (cancel a standing
/// order, change its amount, check a refund). No FK to User on purpose: a task
/// must survive the parent deleting their account.
model BillingTask {
  id             String    @id @default(cuid())
  userId         String?
  subscriptionId String?
  kind           String    // cancel | change_amount | refund_check | unmatched_payment
  title          String
  details        String
  status         String    @default("open") // open | done
  createdAt      DateTime  @default(now())
  doneAt         DateTime?

  @@index([status])
  @@index([subscriptionId])
}

// ── Teachers: one class per teacher, joined by children with the class code ──
// The code is also a discount code: a child in the class of a subscribed teacher
// is billed at the class discount on the parent plan.

model Classroom {
  id        String   @id @default(cuid())
  teacherId String   @unique
  code      String   @unique
  name      String
  createdAt DateTime @default(now())

  teacher User          @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  members ClassMember[]
}

model ClassMember {
  id             String   @id @default(cuid())
  classroomId    String
  childProfileId String   @unique // a child is in at most one class
  joinedAt       DateTime @default(now())

  classroom Classroom    @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  child     ChildProfile @relation(fields: [childProfileId], references: [id], onDelete: Cascade)

  @@index([classroomId])
}

// ── Phase 1: child profiles + per-child progress ─────────────────────────────
// Minimal child PII by design: display name + optional age band only.

model ChildProfile {
  id          String   @id @default(cuid())
  userId      String
  displayName String
  avatar      String   @default("🦉") // emoji avatar
  ageBand     String?  // e.g. "7-8", "9-11"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  progress      Progress[]
  step1Progress Step1Progress[]
  stepStars     StepStars[]
  classMember   ClassMember?
  starDays      StarDay[]

  @@index([userId])
}

// Mirrors the client useProgress shape: per subject+level
model Progress {
  id             String   @id @default(cuid())
  childProfileId String
  subjectId      String
  level          Int
  lessonDone     Boolean  @default(false)
  quizScore      Int      @default(0)
  stars          Int      @default(0)
  gameHighScore  Int      @default(0)
  updatedAt      DateTime @updatedAt

  child ChildProfile @relation(fields: [childProfileId], references: [id], onDelete: Cascade)

  @@unique([childProfileId, subjectId, level])
  @@index([childProfileId])
}

// Mirrors useStep1Progress: exerciseKey → done; stars kept as a counter row
model Step1Progress {
  id             String   @id @default(cuid())
  childProfileId String
  exerciseKey    String   // "track_group_exercise" or "__stars__" counter row
  done           Boolean  @default(true)
  stars          Int      @default(0)
  updatedAt      DateTime @updatedAt

  child ChildProfile @relation(fields: [childProfileId], references: [id], onDelete: Cascade)

  @@unique([childProfileId, exerciseKey])
  @@index([childProfileId])
}

// Mirrors useStepStars: per-step star counters for steps 2-6
model StepStars {
  id             String   @id @default(cuid())
  childProfileId String
  step           String   // "step2" ... "step6"
  stars          Int      @default(0)
  updatedAt      DateTime @updatedAt

  child ChildProfile @relation(fields: [childProfileId], references: [id], onDelete: Cascade)

  @@unique([childProfileId, step])
  @@index([childProfileId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/// Stars earned per child per day (Israel date) — for the weekly sibling challenge,
/// the family goal and the monthly parent report. Filled by the progress sync (deltas only).
model StarDay {
  id             String   @id @default(cuid())
  childProfileId String
  day            DateTime @db.Date
  stars          Int      @default(0)

  child ChildProfile @relation(fields: [childProfileId], references: [id], onDelete: Cascade)

  @@unique([childProfileId, day])
  @@index([childProfileId, day])
}
